---
type Tone = "prompt" | "comment" | "kw" | "str" | "ink" | "muted";

interface Line {
  tone?: Tone;
  parts?: { tone: Tone; text: string }[];
  text?: string;
}

const tabs: {
  id: string;
  label: string;
  title: string;
  body: string;
  filename: string;
  code: Line[];
}[] = [
  {
    id: "cli",
    label: "CLI",
    title: "Shell-first workflow.",
    body: "Two scripts. One for batch runs, one for live ingestion. Flags map 1:1 to PipelineConfig — no surprises.",
    filename: "zsh",
    code: [
      { parts: [{ tone: "prompt", text: "$ " }, { tone: "ink", text: "pip install crypto-portfolio-system" }] },
      { text: "" },
      { parts: [{ tone: "prompt", text: "$ " }, { tone: "ink", text: "crypto-portfolio \\" }] },
      { parts: [{ tone: "ink", text: "    --source yfinance \\" }] },
      { parts: [{ tone: "ink", text: "    --symbols BTC-USD,ETH-USD,SOL-USD,ADA-USD \\" }] },
      { parts: [{ tone: "ink", text: "    --period 6mo \\" }] },
      { parts: [{ tone: "ink", text: "    --forecast-method arima \\" }] },
      { parts: [{ tone: "ink", text: "    --consensus-runs 20 \\" }] },
      { parts: [{ tone: "ink", text: "    --weight-cap 0.35 \\" }] },
      { parts: [{ tone: "ink", text: "    --max-volatility-annual 1.20 \\" }] },
      { parts: [{ tone: "ink", text: "    --output-dir outputs --run-dir runs" }] },
    ],
  },
  {
    id: "py",
    label: "Python API",
    title: "Composable from code.",
    body: "Every dependency is injected. The pipeline, forecaster, store, logger, and governance are all pluggable.",
    filename: "python · run_pipeline.py",
    code: [
      { parts: [
        { tone: "kw", text: "from" }, { tone: "ink", text: " cps " },
        { tone: "kw", text: "import" }, { tone: "ink", text: " (" },
      ] },
      { parts: [
        { tone: "ink", text: "    PipelineConfig, run_pipeline," },
      ] },
      { parts: [
        { tone: "ink", text: "    ForecastService, StructuredLogger," },
      ] },
      { parts: [
        { tone: "ink", text: "    MetricsRegistry, ForecastGovernance," },
      ] },
      { parts: [
        { tone: "ink", text: "    FileArtifactStore," },
      ] },
      { parts: [
        { tone: "ink", text: ")" },
      ] },
      { text: "" },
      { parts: [
        { tone: "ink", text: "config = PipelineConfig(" },
      ] },
      { parts: [
        { tone: "ink", text: "    forecast_method=" }, { tone: "str", text: "\"arima\"" }, { tone: "ink", text: ", random_seed=" }, { tone: "str", text: "42" },
      ] },
      { parts: [{ tone: "ink", text: ")" }] },
      { parts: [{ tone: "ink", text: "artifacts = run_pipeline(" }] },
      { parts: [{ tone: "ink", text: "    prices, config," }] },
      { parts: [{ tone: "ink", text: "    artifact_store=FileArtifactStore(" }, { tone: "str", text: "\"outputs\"" }, { tone: "ink", text: ")," }] },
      { parts: [{ tone: "ink", text: "    logger=StructuredLogger(" }, { tone: "str", text: "\"cps\"" }, { tone: "ink", text: ", " }, { tone: "str", text: "\"outputs/events.jsonl\"" }, { tone: "ink", text: ")," }] },
      { parts: [{ tone: "ink", text: "    metrics_registry=MetricsRegistry()," }] },
      { parts: [{ tone: "ink", text: "    governance=ForecastGovernance()," }] },
      { parts: [{ tone: "ink", text: "    forecast_service=ForecastService()," }] },
      { parts: [{ tone: "ink", text: ")" }] },
    ],
  },
  {
    id: "api",
    label: "REST API",
    title: "Stateless HTTP surface.",
    body: "Submit a run with a config and CSV body, then read back trades, metrics, summary, and log-returns.",
    filename: "http · /api/v1/runs",
    code: [
      { tone: "comment", text: "# Submit a run" },
      { parts: [
        { tone: "kw", text: "curl" }, { tone: "ink", text: " -X POST http://localhost:8000/api/v1/runs " },
      ] },
      { parts: [{ tone: "ink", text: "  -H " }, { tone: "str", text: "'Content-Type: application/json'" }, { tone: "ink", text: " \\" }] },
      { parts: [{ tone: "ink", text: "  -d " }, { tone: "str", text: "'{" }] },
      { parts: [{ tone: "str", text: "    \"config\": {\"forecast_method\": \"arima\"}," }] },
      { parts: [{ tone: "str", text: "    \"prices_csv_content\": \"date,btc,eth\\n...\"" }] },
      { parts: [{ tone: "str", text: "  }'" }] },
      { text: "" },
      { tone: "comment", text: "# Read artefacts back" },
      { parts: [{ tone: "kw", text: "curl" }, { tone: "ink", text: " http://localhost:8000/api/v1/runs/{run_id}/summary" }] },
      { parts: [{ tone: "kw", text: "curl" }, { tone: "ink", text: " http://localhost:8000/api/v1/runs/{run_id}/trades" }] },
      { parts: [{ tone: "kw", text: "curl" }, { tone: "ink", text: " http://localhost:8000/api/v1/runs/{run_id}/metrics" }] },
    ],
  },
  {
    id: "live",
    label: "Live ingest",
    title: "Poll any ccxt exchange.",
    body: "Long-running poller writes long-form OHLCV. Pivot to wide and feed straight into the pipeline.",
    filename: "zsh · cps-realtime",
    code: [
      { parts: [
        { tone: "prompt", text: "$ " },
        { tone: "ink", text: "pip install -e " },
        { tone: "str", text: "\".[realtime]\"" },
      ] },
      { text: "" },
      { parts: [{ tone: "prompt", text: "$ " }, { tone: "ink", text: "cps-realtime \\" }] },
      { parts: [{ tone: "ink", text: "    --exchange binance \\" }] },
      { parts: [{ tone: "ink", text: "    --symbols BTC/USDT,ETH/USDT,SOL/USDT \\" }] },
      { parts: [{ tone: "ink", text: "    --output-csv prices.csv \\" }] },
      { parts: [{ tone: "ink", text: "    --timeframe 1m \\" }] },
      { parts: [{ tone: "ink", text: "    --interval-seconds 60 \\" }] },
      { parts: [{ tone: "ink", text: "    --max-iterations 0" }] },
    ],
  },
];

const toneClass: Record<Tone, string> = {
  prompt: "text-signal-400",
  comment: "text-ink-500",
  kw: "text-violet-300",
  str: "text-amber-300/90",
  ink: "text-ink-200",
  muted: "text-transparent",
};
---

<section id="interfaces" class="relative scroll-mt-28">
  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32">
    <div class="grid items-end gap-6 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <span class="eyebrow reveal">Interfaces</span>
        <h2 class="display reveal delay-100 mt-4 text-4xl text-balance text-ink-50 sm:text-5xl lg:text-6xl">
          One framework.<br />Four ways to use it.
        </h2>
      </div>
      <p class="reveal delay-200 lg:col-span-5 text-lg text-ink-400">
        CLI for scripting, Python API for notebooks and services, REST for stateless
        backends, and a live poller for real-time research.
      </p>
    </div>

    <div class="reveal delay-300 mt-12">
      <div class="card overflow-hidden">
        <div role="tablist" aria-label="Interface examples" class="flex flex-wrap gap-1 border-b border-white/5 p-2">
          {tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              data-tab={t.id}
              aria-selected={i === 0 ? "true" : "false"}
              class={`tab-btn rounded-full px-4 py-1.5 text-sm font-medium transition-colors ${
                i === 0
                  ? "bg-white/10 text-ink-50"
                  : "text-ink-400 hover:bg-white/5 hover:text-ink-200"
              }`}
            >
              {t.label}
            </button>
          ))}
        </div>

        <div class="grid items-stretch gap-0 lg:grid-cols-12">
          {tabs.map((t, i) => (
            <div
              role="tabpanel"
              data-panel={t.id}
              class={`tab-panel grid items-center gap-6 p-6 sm:p-8 lg:col-span-12 lg:grid-cols-12 ${
                i === 0 ? "" : "hidden"
              }`}
            >
              <div class="lg:col-span-5">
                <h3 class="display text-2xl text-ink-50 sm:text-3xl">{t.title}</h3>
                <p class="mt-3 text-ink-400">{t.body}</p>
                <div class="mt-6 flex flex-wrap gap-2">
                  <span class="pill">config-as-flags</span>
                  <span class="pill">idempotent runs</span>
                  <span class="pill">jsonl events</span>
                </div>
              </div>
              <div class="lg:col-span-7">
                <div class="code-block relative overflow-hidden">
                  <div class="flex items-center justify-between border-b border-white/5 px-4 py-2.5">
                    <div class="mono text-[11px] text-ink-500">
                      {t.filename}
                    </div>
                    <div class="text-ink-500">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M5 15V5a2 2 0 012-2h10" stroke="currentColor" stroke-width="1.6"/>
                      </svg>
                    </div>
                  </div>
                  <pre class="mono overflow-x-auto p-5 text-[12.5px] leading-[1.75]"><code>{t.code.map((line) => (
                    <span class="block">
                      {line.parts ? (
                        line.parts.map((p) => <span class={toneClass[p.tone]}>{p.text}</span>)
                      ) : (
                        <span class={toneClass[line.tone ?? "muted"]}>{line.text ?? ""}</span>
                      )}
                    </span>
                  ))}</code></pre>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.tab;
        buttons.forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-selected", active ? "true" : "false");
          b.classList.toggle("bg-white/10", active);
          b.classList.toggle("text-ink-50", active);
          b.classList.toggle("text-ink-400", !active);
        });
        panels.forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== id));
      });
    });
  </script>
</section>