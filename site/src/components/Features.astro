---
const features = [
  {
    title: "Multi-method forecasting",
    body: "Naive, ARIMA, GARCH with AIC-selected orders, and a shared multi-asset LSTM — swappable per run with a single flag.",
    icon: "forecast",
    accent: "signal",
  },
  {
    title: "Consensus Louvain",
    body: "Stable community detection across N independent Louvain runs, with co-occurrence threshold and Jaccard stability metrics.",
    icon: "graph",
    accent: "violet",
  },
  {
    title: "Sharpe-ratio optimisation",
    body: "Ledoit-Wolf covariance shrinkage, per-asset caps, asset-count and volatility ceilings — all in one objective.",
    icon: "asc",
    accent: "signal",
  },
  {
    title: "Risk & execution modelling",
    body: "Transaction costs and slippage applied to net returns; per-rebalance turnover surfaced in every artefact.",
    icon: "shield",
    accent: "violet",
  },
  {
    title: "Governance & drift",
    body: "Forecast drift detection and MSE tracking over time. Pipeline emits events, metrics, and structured logs.",
    icon: "pulse",
    accent: "signal",
  },
  {
    title: "Pluggable & layered",
    body: "Hexagonal architecture. Domain is pure Python; infrastructure is swappable. Ships CLI, REST, Docker, and ccxt poller.",
    icon: "stack",
    accent: "violet",
  },
];
---

<section id="features" class="relative scroll-mt-28">
  <div class="absolute inset-x-0 top-0 -z-10 h-px bg-white/5"></div>

  <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 sm:py-32">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <span class="eyebrow reveal">Features</span>
        <h2 class="display reveal delay-100 mt-4 text-4xl text-balance text-ink-50 sm:text-5xl">
          Everything a quant pipeline needs.<br />Nothing it doesn't.
        </h2>
      </div>
      <p class="reveal delay-200 max-w-md text-ink-400">
        Designed for serious work — observable, testable, and built on the research literature.
      </p>
    </div>

    <div class="reveal delay-300 mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f) => (
        <article class="card card-hover relative overflow-hidden p-6">
          <div
            aria-hidden="true"
            class={`pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full blur-3xl opacity-50 ${
              f.accent === "signal" ? "bg-signal-500/30" : "bg-violet-400/25"
            }`}
          ></div>

          <div class="relative flex items-start gap-4">
            <div
              class={`grid h-10 w-10 shrink-0 place-items-center rounded-xl ${
                f.accent === "signal"
                  ? "bg-signal-500/10 text-signal-300 ring-1 ring-inset ring-signal-500/20"
                  : "bg-violet-400/10 text-violet-300 ring-1 ring-inset ring-violet-400/20"
              }`}
            >
              {f.icon === "forecast" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M3 17l6-6 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M14 7h7v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {f.icon === "graph" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="6" cy="6" r="2" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="18" cy="6" r="2" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="6" cy="18" r="2" stroke="currentColor" stroke-width="1.6"/>
                  <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.6"/>
                  <path d="M8 6h8M6 8v8M18 8v8M8 18h8" stroke="currentColor" stroke-width="1.4"/>
                </svg>
              )}
              {f.icon === "asc" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 19l8-8 4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M16 11h4v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {f.icon === "shield" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {f.icon === "pulse" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M3 12h4l2-6 4 12 2-6h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {f.icon === "stack" && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3l9 5-9 5-9-5 9-5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M3 13l9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M3 17l9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-base font-semibold tracking-tight text-ink-50">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-400">{f.body}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>