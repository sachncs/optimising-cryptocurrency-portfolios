---
---

<section class="relative">
  <div class="mx-auto max-w-7xl px-5 pb-24 sm:px-8 sm:pb-32">
    <div class="reveal card relative overflow-hidden p-10 sm:p-16">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-90"
        style="background:
          radial-gradient(80% 60% at 0% 0%, rgba(52,211,153,0.18), transparent 60%),
          radial-gradient(60% 60% at 100% 100%, rgba(167,139,250,0.16), transparent 60%);"
      ></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 grain"></div>

      <div class="relative grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <span class="pill"><span class="pill-dot"></span> Ready when you are</span>
          <h2 class="display mt-5 text-3xl text-balance text-ink-50 sm:text-5xl">
            Build portfolios the research-grade way.
          </h2>
          <p class="mt-4 max-w-xl text-lg text-ink-300">
            Install CPS, point it at any source — CSV, yfinance, or live ccxt — and ship a deterministic, risk-aware crypto portfolio.
          </p>
        </div>
        <div class="lg:col-span-4">
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a href="#install" class="btn-primary w-full">
              Install with pip
            </a>
            <a
              href="https://github.com/sachncs/optimising-cryptocurrency-portfolios"
              rel="noopener"
              target="_blank"
              class="btn-ghost w-full"
            >
              Read the source
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
          <p class="mt-4 text-xs text-ink-500">
            MIT license · v0.1.0 · Tested on 3.10 / 3.11 / 3.12
          </p>
        </div>
      </div>
    </div>
  </div>
</section>