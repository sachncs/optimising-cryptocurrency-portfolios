---
import Terminal from "./Terminal.astro";
---

<section class="relative overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-grid-soft"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[820px] mask-fade-b"
    style="background:
      radial-gradient(60% 50% at 50% 0%, rgba(52,211,153,0.22), transparent 70%),
      radial-gradient(40% 40% at 80% 20%, rgba(167,139,250,0.18), transparent 70%),
      radial-gradient(50% 50% at 10% 10%, rgba(52,211,153,0.10), transparent 70%);"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[1200px] grid-pattern mask-radial-fade opacity-40"
  ></div>

  <div class="relative mx-auto max-w-7xl px-5 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16 lg:pb-36 lg:pt-20">
    <div class="mx-auto max-w-3xl text-center">
      <div class="reveal">
        <span class="pill mx-auto">
          <span class="pill-dot"></span>
          v0.1.0 · Implementing arXiv:2505.24831v2
        </span>
      </div>

      <h1 class="display reveal delay-100 mt-6 text-[28px] leading-[1.06] tracking-[-0.035em] text-balance text-ink-50 [overflow-wrap:anywhere] sm:text-[56px] sm:leading-[1.02] sm:tracking-[-0.04em] lg:text-[84px]">
        Crypto portfolios,<br class="hidden sm:inline" />
        built on <span class="text-gradient-accent">consensus.</span>
      </h1>

      <p class="reveal delay-200 mx-auto mt-7 max-w-2xl text-pretty text-base leading-relaxed text-ink-300 sm:text-xl">
        A production-grade Python framework for cryptocurrency portfolio construction. Consensus Louvain clustering,
        Ledoit-Wolf shrinkage, and Sharpe-ascent optimisation — packaged for quant teams who ship.
      </p>

      <div class="reveal delay-300 mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#install"
          class="btn-primary w-full sm:w-auto"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Install with pip
        </a>
        <a
          href="https://github.com/sachncs/optimising-cryptocurrency-portfolios"
          rel="noopener"
          target="_blank"
          class="btn-ghost w-full sm:w-auto"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.02c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.74-1.55-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.19-3.07-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.17a11 11 0 0 1 5.78 0c2.21-1.48 3.18-1.17 3.18-1.17.63 1.58.23 2.75.12 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.7 5.36-5.26 5.65.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
          </svg>
          View on GitHub
          <span class="ml-1 inline-flex items-center gap-1 rounded-md border border-white/10 bg-white/5 px-1.5 py-0.5 text-[10px] font-medium text-ink-300">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21 12 17.27z"/></svg>
            Star
          </span>
        </a>
      </div>

      <div class="reveal delay-400 mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-xs text-ink-500">
        <span class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Python 3.10 · 3.11 · 3.12</span>
        <span class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg> Stateless FastAPI surface</span>
        <span class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="2"/><path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> Docker-ready</span>
      </div>
    </div>

    <div class="reveal delay-500 relative mx-auto mt-20 max-w-6xl">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -inset-x-20 -top-10 -z-10 h-full bg-[radial-gradient(60%_60%_at_50%_0%,rgba(52,211,153,0.18),transparent_70%)]"
      ></div>

      <div class="grid items-stretch gap-4 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <Terminal />
        </div>
        <div class="grid gap-4 lg:col-span-4">
          <div class="card card-hover relative overflow-hidden p-5">
            <div class="flex items-start justify-between">
              <div class="text-xs text-ink-400">Sharpe (annualised)</div>
              <span class="rounded-md bg-signal-500/10 px-2 py-0.5 text-[10px] font-medium text-signal-300">live</span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
              <span class="display text-3xl text-ink-50">1.84</span>
              <span class="text-xs text-ink-500">net of costs</span>
            </div>
            <svg class="mt-4 h-16 w-full" viewBox="0 0 200 60" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="spark1" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="#34d399" stop-opacity="0.5"/>
                  <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,46 L20,40 L40,42 L60,32 L80,34 L100,22 L120,26 L140,16 L160,18 L180,8 L200,12 L200,60 L0,60 Z" fill="url(#spark1)"/>
              <path d="M0,46 L20,40 L40,42 L60,32 L80,34 L100,22 L120,26 L140,16 L160,18 L180,8 L200,12" stroke="#34d399" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="card card-hover relative overflow-hidden p-5">
            <div class="flex items-start justify-between">
              <div class="text-xs text-ink-400">Stable communities</div>
              <span class="rounded-md bg-violet-400/10 px-2 py-0.5 text-[10px] font-medium text-violet-300">consensus</span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
              <span class="display text-3xl text-ink-50">12</span>
              <span class="text-xs text-ink-500">across 80 assets</span>
            </div>
            <div class="mt-4 flex flex-wrap gap-1">
              {Array.from({ length: 18 }).map((_, i) => (
                <span
                  class="block h-2.5 rounded-sm"
                  style={`width:${6 + (i * 7) % 14}px;background:hsla(${150 + (i * 19) % 60}, 60%, ${30 + (i * 5) % 25}%, ${0.4 + (i % 4) * 0.15})`}
                ></span>
              ))}
            </div>
          </div>

          <div class="card card-hover relative overflow-hidden p-5">
            <div class="text-xs text-ink-400">Pipeline runtime</div>
            <div class="mt-3 flex items-baseline gap-2">
              <span class="display text-3xl text-ink-50">~3.2s</span>
              <span class="text-xs text-ink-500">per rebalance</span>
            </div>
            <div class="mt-4 space-y-2 text-[11px] text-ink-400">
              <div class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-signal-400"></span> Ingest 0.4s</div>
              <div class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-violet-400"></span> Louvain consensus 1.1s</div>
              <div class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-signal-400"></span> Sharpe ascent 1.7s</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>