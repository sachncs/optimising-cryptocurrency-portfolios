---
const items = [
  "NumPy",
  "pandas",
  "PyTorch",
  "NetworkX",
  "statsmodels",
  "arch",
  "FastAPI",
  "Uvicorn",
  "yfinance",
  "ccxt",
  "pytest",
  "ruff",
  "mypy",
  "Docker",
];
---

<section class="relative overflow-hidden border-y border-white/5 bg-night-50/40 py-10">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="text-center text-xs uppercase tracking-[0.22em] text-ink-500">
      Built on the shoulders of
    </p>
  </div>

  <div class="relative mt-6 overflow-hidden">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-night-50 to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-night-50 to-transparent"></div>
    <div class="flex w-max gap-12 animate-marquee will-change-transform">
      {[...items, ...items].map((label, i) => (
        <div class="flex shrink-0 items-center gap-3 text-ink-400">
          <span class="block h-1.5 w-1.5 rounded-full bg-ink-700"></span>
          <span class="mono text-[15px]">{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>