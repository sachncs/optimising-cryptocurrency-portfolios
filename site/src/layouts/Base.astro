---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "CPS — Consensus-clustered crypto portfolio construction",
  description = "A production-grade Python framework for cryptocurrency portfolio construction. Consensus Louvain clustering, Ledoit-Wolf shrinkage, Sharpe-ascent optimisation — packaged for quant teams.",
  ogImage = "/og.svg",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const favicon = `${base}/favicon.svg`;
const manifest = `${base}/manifest.webmanifest`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${base}${ogImage.startsWith("/") ? ogImage : `/${ogImage}`}`;
const robots = `${base}/robots.txt`;

const navItems = [
  { href: "#pipeline", label: "Pipeline" },
  { href: "#features", label: "Features" },
  { href: "#interfaces", label: "Interfaces" },
  { href: "#install", label: "Install" },
  { href: "#faq", label: "FAQ" },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="mask-icon" href={favicon} color="#34d399" />
    <link rel="apple-touch-icon" href={favicon} />
    <link rel="manifest" href={manifest} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sachin" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="CPS" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Crypto Portfolio System",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Linux, macOS, Windows",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
      },
      "url": "https://sachncs.github.io/optimising-cryptocurrency-portfolios/",
      "description": description,
    })} />
  </head>
  <body class="bg-night-0 text-ink-50 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-night-300 focus:px-3 focus:py-2 focus:text-sm focus:text-ink-50"
    >
      Skip to content
    </a>

    <header class="fixed inset-x-0 top-0 z-40 transition-all duration-300" id="site-nav">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 pt-4">
        <nav
          class="glass flex items-center justify-between rounded-full px-3 py-2 sm:px-4 sm:py-2.5"
          aria-label="Primary"
        >
          <a href={`${base}/`} class="group flex items-center gap-2.5 pl-1">
            <span
              class="relative grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-signal-400 to-signal-600 text-night-0 shadow-[inset_0_1px_0_rgba(255,255,255,0.4)] transition-transform group-hover:scale-105"
              aria-hidden="true"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M2 13L6.5 7L9 10L14 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="14" cy="3" r="1.4" fill="currentColor"/>
              </svg>
            </span>
            <span class="text-[15px] font-semibold tracking-tight">CPS</span>
            <span class="hidden text-xs text-ink-500 sm:inline-block">Crypto Portfolio System</span>
          </a>

          <ul class="hidden items-center gap-1 md:flex">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="rounded-full px-3.5 py-1.5 text-sm text-ink-300 transition-colors hover:bg-white/5 hover:text-ink-50"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-2">
            <a
              href="https://github.com/sachncs/optimising-cryptocurrency-portfolios"
              rel="noopener"
              target="_blank"
              aria-label="GitHub repository"
              class="hidden h-9 w-9 items-center justify-center rounded-full text-ink-300 transition-colors hover:bg-white/5 hover:text-ink-50 sm:inline-flex"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.02c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.74-1.55-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.19-3.07-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.17a11 11 0 0 1 5.78 0c2.21-1.48 3.18-1.17 3.18-1.17.63 1.58.23 2.75.12 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.7 5.36-5.26 5.65.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"/>
              </svg>
            </a>
            <a
              href="#install"
              class="btn-primary hidden sm:inline-flex !py-1.5 !px-3.5 !text-[13px]"
            >
              Get started
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M5 12h14M13 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <button
              id="mobile-nav-toggle"
              aria-label="Open navigation"
              class="inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-300 hover:bg-white/5 md:hidden"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </nav>

        <div
          id="mobile-nav"
          class="md:hidden mt-2 hidden rounded-2xl glass p-2"
        >
          <ul class="flex flex-col">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-xl px-3 py-2.5 text-sm text-ink-200 transition-colors hover:bg-white/5"
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="mt-1 border-t border-white/5 pt-1">
              <a
                href="https://github.com/sachncs/optimising-cryptocurrency-portfolios"
                rel="noopener"
                target="_blank"
                class="block rounded-xl px-3 py-2.5 text-sm text-ink-200 transition-colors hover:bg-white/5"
              >
                GitHub ↗
              </a>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <main id="main" class="relative isolate pt-24 sm:pt-28">
      <slot />
    </main>

    <div class="relative">
      <div class="divider"></div>
      <footer class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
        <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:grid-cols-6">
          <div class="col-span-2 lg:col-span-2">
            <a href={`${base}/`} class="flex items-center gap-2.5">
              <span
                class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-signal-400 to-signal-600 text-night-0"
                aria-hidden="true"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M2 13L6.5 7L9 10L14 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  <circle cx="14" cy="3" r="1.4" fill="currentColor"/>
                </svg>
              </span>
              <span class="text-[15px] font-semibold tracking-tight">CPS</span>
            </a>
            <p class="mt-4 max-w-xs text-sm text-ink-400">
              Production-grade consensus clustering for crypto portfolios. Open source, MIT licensed.
            </p>
            <div class="mt-5 flex items-center gap-2">
              <span class="pill"><span class="pill-dot"></span> v0.1.0</span>
              <span class="pill">MIT</span>
            </div>
          </div>

          <div>
            <h4 class="eyebrow mb-4">Product</h4>
            <ul class="space-y-2.5 text-sm text-ink-300">
              <li><a class="hover:text-ink-50" href="#pipeline">Pipeline</a></li>
              <li><a class="hover:text-ink-50" href="#features">Features</a></li>
              <li><a class="hover:text-ink-50" href="#interfaces">Interfaces</a></li>
              <li><a class="hover:text-ink-50" href="#install">Install</a></li>
            </ul>
          </div>

          <div>
            <h4 class="eyebrow mb-4">Resources</h4>
            <ul class="space-y-2.5 text-sm text-ink-300">
              <li><a class="hover:text-ink-50" href="https://arxiv.org/abs/2505.24831v2" target="_blank" rel="noopener">Research paper ↗</a></li>
              <li><a class="hover:text-ink-50" href="https://pypi.org/project/crypto-portfolio-system/" target="_blank" rel="noopener">PyPI ↗</a></li>
              <li><a class="hover:text-ink-50" href="https://github.com/sachncs/optimising-cryptocurrency-portfolios" target="_blank" rel="noopener">GitHub ↗</a></li>
              <li><a class="hover:text-ink-50" href="https://github.com/sachncs/optimising-cryptocurrency-portfolios/blob/master/CHANGELOG.md" target="_blank" rel="noopener">Changelog ↗</a></li>
            </ul>
          </div>

          <div>
            <h4 class="eyebrow mb-4">Project</h4>
            <ul class="space-y-2.5 text-sm text-ink-300">
              <li><a class="hover:text-ink-50" href="https://github.com/sachncs/optimising-cryptocurrency-portfolios/blob/master/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing</a></li>
              <li><a class="hover:text-ink-50" href="https://github.com/sachncs/optimising-cryptocurrency-portfolios/blob/master/SECURITY.md" target="_blank" rel="noopener">Security</a></li>
              <li><a class="hover:text-ink-50" href="https://github.com/sachncs/optimising-cryptocurrency-portfolios/blob/master/CODE_OF_CONDUCT.md" target="_blank" rel="noopener">Code of conduct</a></li>
              <li><a class="hover:text-ink-50" href="https://github.com/sachncs/optimising-cryptocurrency-portfolios/blob/master/LICENSE" target="_blank" rel="noopener">License</a></li>
            </ul>
          </div>

          <div>
            <h4 class="eyebrow mb-4">Status</h4>
            <ul class="space-y-2.5 text-sm text-ink-300">
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-signal-400 shadow-[0_0_8px_#34d399]"></span> API stable</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-signal-400 shadow-[0_0_8px_#34d399]"></span> CI green</li>
              <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-violet-400 shadow-[0_0_8px_#a78bfa]"></span> Alpha</li>
            </ul>
          </div>
        </div>

        <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-white/5 pt-8 text-xs text-ink-500 sm:flex-row sm:items-center">
          <p>© 2026 Sachin · Released under the MIT License.</p>
          <p class="flex items-center gap-2">
            <span>Built with</span>
            <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-ink-300">Astro</span>
            <span>+</span>
            <span class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-ink-300">Tailwind</span>
          </p>
        </div>
      </footer>
    </div>

    <script>
      const navEl = document.getElementById("site-nav");
      const onScroll = () => {
        if (!navEl) return;
        if (window.scrollY > 8) {
          navEl.classList.add("nav-scrolled");
        } else {
          navEl.classList.remove("nav-scrolled");
        }
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      const toggle = document.getElementById("mobile-nav-toggle");
      const menu = document.getElementById("mobile-nav");
      toggle?.addEventListener("click", () => {
        menu?.classList.toggle("hidden");
      });
      menu?.querySelectorAll("a").forEach((a) =>
        a.addEventListener("click", () => menu?.classList.add("hidden"))
      );

const reveals = Array.from(document.querySelectorAll(".reveal"));
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: "0px 0px -6% 0px" }
        );
        reveals.forEach((el) => io.observe(el));
        setTimeout(() => reveals.forEach((el) => el.classList.add("is-in")), 2500);
      } else {
        reveals.forEach((el) => el.classList.add("is-in"));
      }
    </script>

    <style>
      .nav-scrolled nav {
        background: linear-gradient(180deg, rgba(8, 8, 11, 0.78), rgba(8, 8, 11, 0.55));
        border-color: rgba(255, 255, 255, 0.1);
      }
    </style>
  </body>
</html>